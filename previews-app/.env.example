VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Confirm your production origin before publication.
SITE_URL=
# Photo/video placeholders are shown locally by default. Set 0 to hide locally,
# or 1 to include them in a build or preview.
VITE_SHOW_PLACEHOLDERS=

# SERVER ONLY: never prefix these with VITE_.
# Verified sender address, e.g. GraspIT <uzklausos@your-verified-domain.lt>
CONTACT_FROM=
# Inbox that receives project inquiries.
CONTACT_TO=
# Resend sending-only API key; set in .env.local or hosting secrets.
RESEND_API_KEY=
